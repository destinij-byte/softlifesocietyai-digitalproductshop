# The Soft Life Vault is a client-side-routed React SPA. Without this,
# refreshing or direct-linking to any path other than / (e.g. /login,
# /shop, /library) 404s at the Apache level instead of loading the app -
# route the request to index.html and let React Router take over.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Real files and directories (assets, this file itself) serve as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else falls back to index.html.
  RewriteRule ^ index.html [L]
</IfModule>

# index.html is the only file whose *content* changes on every deploy
# without its *filename* changing - a browser that caches it can keep
# pointing at asset filenames from an old build indefinitely, so it must
# always be revalidated. The hashed files under /assets get a new
# filename on every build instead, so those are safe to cache hard.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpg|jpeg|svg|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
