# Mongo
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=soft_life_society

# Auth (shared with the rest of the SLS app)
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=https://app.softlifesociety.ai/academy/checkout/success
STRIPE_CANCEL_URL=https://app.softlifesociety.ai/academy/checkout/cancelled

# Email (SendGrid or Postmark - pick one)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.xxx
POSTMARK_SERVER_TOKEN=xxx
EMAIL_FROM_ADDRESS=hello@softlifesociety.ai
EMAIL_FROM_NAME=Soft Life Society

# Workbook signed URL secret
WORKBOOK_URL_SECRET=change-me-too
WORKBOOK_URL_EXPIRE_SECONDS=900

# Inactivity nudge job
INACTIVITY_NUDGE_DAYS=5

# The Soft Life Vault (digital product shop)
VAULT_STRIPE_SUCCESS_URL=https://vault.softlifesociety.ai/checkout/success
VAULT_STRIPE_CANCEL_URL=https://vault.softlifesociety.ai/checkout/cancelled
VAULT_DOWNLOAD_SECRET=change-me-vault
VAULT_DOWNLOAD_EXPIRE_SECONDS=900

# Browser origins allowed to call this API (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=https://academy.softlifesocietyai.com,https://softlifesocietyai.com
